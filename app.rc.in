// Windows 资源: ModbusTools.exe 的图标 + VERSIONINFO
// (版本号由 CMake configure_file 注入, 来自 project(VERSION))

IDI_ICON1 ICON "@MBTOOLS_ICO@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004   // VOS_NT_WINDOWS32
FILETYPE 0x1     // VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"  // 简体中文 + Unicode
    BEGIN
      VALUE "CompanyName",      "ST072G"
      VALUE "FileDescription",  "STModbusTools (Modbus 主站调试工具)"
      VALUE "FileVersion",      "@PROJECT_VERSION@"
      VALUE "InternalName",     "STModbusTools"
      VALUE "LegalCopyright",   "ST072G"
      VALUE "OriginalFilename", "STModbusTools.exe"
      VALUE "ProductName",      "STModbusTools"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200  // 简体中文, Unicode
  END
END
